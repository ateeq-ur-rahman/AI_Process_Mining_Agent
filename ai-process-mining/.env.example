# Copy to .env for Docker Compose. .env is git-ignored; keep real keys out of this file.
# Running the backend outside Docker? It doesn't read .env: export the variables instead.

# Database. Compose builds DATABASE_URL from these.
# Outside Docker, set DATABASE_URL directly, e.g.
#   DATABASE_URL=postgresql+psycopg://apm:apm@localhost:5432/apm
#   DATABASE_URL=sqlite:///./apm_local.db
POSTGRES_USER=apm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apm

# Uploads
MAX_UPLOAD_MB=50
MAX_ROWS=1000000
# Timezone assumed for timestamps that carry no UTC offset
DEFAULT_TIMEZONE=UTC
LOG_LEVEL=INFO

# LLM (optional). With LLM_PROVIDER=none everything still works; the analyst uses templates.
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_S=90
LLM_MAX_TOKENS=4000
# Optional USD per million tokens, only used to estimate cost in the ai_runs audit table
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
